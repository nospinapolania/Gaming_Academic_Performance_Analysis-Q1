		summarizeBy: none

	/// Four equal-size groups at refresh, ordered by reaction time then student_id to break ties. Q1 is fastest. Groups stay fixed when filtering.
	column reaction_quartile =
			VAR current_time = [reaction_time_ms]
			VAR current_id = [student_id]
			VAR valid_students = FILTER(ALL('vw_student_segments'[reaction_time_ms], 'vw_student_segments'[student_id]), NOT ISBLANK('vw_student_segments'[reaction_time_ms]))
			VAR row_position = COUNTROWS(FILTER(valid_students,
			    'vw_student_segments'[reaction_time_ms] < current_time ||
			    ('vw_student_segments'[reaction_time_ms] = current_time && 'vw_student_segments'[student_id] <= current_id)))
			VAR total_rows = COUNTROWS(valid_students)
			VAR small_size = INT(total_rows / 4)
			VAR extra_groups = MOD(total_rows, 4)
			VAR large_rows = (small_size + 1) * extra_groups
			RETURN IF(ISBLANK(current_time), BLANK(),
			    IF(row_position <= large_rows,
			        ROUNDUP(DIVIDE(row_position, small_size + 1), 0),
			        extra_groups + ROUNDUP(DIVIDE(row_position - large_rows, small_size), 0)))
		dataType: int64
		formatString: "Q"0
		lineageTag: e284fe04-c08f-4a92-b685-8e6bf34aca30
		summarizeBy: none

