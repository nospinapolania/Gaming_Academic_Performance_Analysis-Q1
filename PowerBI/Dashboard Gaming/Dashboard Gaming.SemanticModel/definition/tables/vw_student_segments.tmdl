	/// Pearson correlation calculated from students in the current filter context. Blank for fewer than two valid pairs or zero variance.
	measure correlation_grade =
			VAR chosen_variable = SELECTEDVALUE('correlation_with_grades'[variable])
			VAR pairs = FILTER(
			    SELECTCOLUMNS('vw_student_segments',
			        "x_value", SWITCH(chosen_variable,
			            "Study", 'vw_student_segments'[study_hours],
			            "Sleep", 'vw_student_segments'[sleep_hours],
			            "Attendance", 'vw_student_segments'[attendance],
			            "Gaming", 'vw_student_segments'[gaming_hours],
			            "Addiction", 'vw_student_segments'[addiction_score]),
			        "y_value", 'vw_student_segments'[grades]),
			    NOT ISBLANK([x_value]) && NOT ISBLANK([y_value]))
			VAR mean_x = AVERAGEX(pairs, [x_value])
			VAR mean_y = AVERAGEX(pairs, [y_value])
			VAR numerator = SUMX(pairs, ([x_value] - mean_x) * ([y_value] - mean_y))
			VAR denominator = SQRT(SUMX(pairs, POWER([x_value] - mean_x, 2)) * SUMX(pairs, POWER([y_value] - mean_y, 2)))
			RETURN IF(COUNTROWS(pairs) < 2, BLANK(), DIVIDE(numerator, denominator))
		formatString: 0.000
		displayFolder: Dashboard
		lineageTag: 675c3f49-0a62-48b5-931d-10a09e0390b5

