	partition vw_student_segments = m
		mode: import
		source =
				let
				    SourceTable = (
				let
				    Origen = Odbc.DataSource("dsn=mysql_powerbi", [HierarchicalNavigation=true]),
				    repositorios_Database = Origen{[Name="repositorios",Kind="Database"]}[Data],
				    vw_student_segments_View = repositorios_Database{[Name="vw_student_segments",Kind="View"]}[Data]
				in
				    vw_student_segments_View
				    ),
				    AddedOrder1 = Table.AddColumn(SourceTable, "gaming_band_order", each let position = List.PositionOf({"0-2h", "2-4h", "4-6h", "6-8h"}, [gaming_band]) in if position < 0 then 99 else position + 1, Int64.Type),
				    AddedOrder2 = Table.AddColumn(AddedOrder1, "study_band_order", each let position = List.PositionOf({"1-3h", "3-6h", "6-8h", "8-10h"}, [study_band]) in if position < 0 then 99 else position + 1, Int64.Type),
				    AddedOrder3 = Table.AddColumn(AddedOrder2, "sleep_band_order", each let position = List.PositionOf({"<5h", "5-7h", "7-8h", "8h+"}, [sleep_band]) in if position < 0 then 99 else position + 1, Int64.Type),
				    AddedOrder4 = Table.AddColumn(AddedOrder3, "stress_level_order", each let position = List.PositionOf({"Low", "Medium", "High"}, [stress_level]) in if position < 0 then 99 else position + 1, Int64.Type),
				    AddedOrder5 = Table.AddColumn(AddedOrder4, "performance_band_order", each let position = List.PositionOf({"At Risk", "Regular", "Solid", "Excellent"}, [performance_band]) in if position < 0 then 99 else position + 1, Int64.Type)
				in
				    AddedOrder5

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

